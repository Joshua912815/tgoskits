{
  "permissions": {
    "allow": [
      "Bash(cargo xtask *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(python3 scripts/starry-evolve/evolve.py *)",
      "Bash(scripts/starry-evolve/prepare_pair_test.sh *)",
      "Bash(scripts/starry-evolve/run_syncfs_pair.sh *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(cat *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 scripts/starry-evolve/hooks/session_context.py"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 scripts/starry-evolve/hooks/pre_commit_check.py"
      }
    ]
  }
}
